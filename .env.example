# Supabase project URL and PUBLIC anon/publishable key. Never use a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative (optional): NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only; never prefix this key with NEXT_PUBLIC_.
GEMINI_API_KEY=
# A structured-output capable GenerateContent model available to your account.
GEMINI_MODEL=gemini-2.5-flash
